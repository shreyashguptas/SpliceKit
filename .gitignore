# Build artifacts
build/
*.dylib
*.o
*.a
.build/

# Python
__pycache__/
*.pyc
.env*

# macOS
.DS_Store
._*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
xcuserdata/

# Xcode build artifacts
DerivedData/
patcher/build/

# Keys and credentials
*.pem
*.key
*.p12
*.pfx
*.jks
.credentials
credentials.json

# Swift packages
Package.resolved
# ...except the transcription helpers. These are applications, not libraries, so
# their lockfile belongs in the repo. Ignoring it let FluidAudio float from the
# 0.12 series the source was written against to 0.15.7, which renamed the
# transcription API — a clean checkout then failed to build, and the Parakeet
# engine reported a missing binary instead of a broken build.
!tools/*/Package.resolved

# Local scratch/test binaries and artifacts
out/

# Local dev artifacts (not part of any release)
.playwright-mcp/
edit-helper.yml

# Claude Code per-project memory (never commit)
.claude/

# MCP client config — generated per machine by Scripts/setup-mcp.sh.
# It holds absolute paths to this checkout and to the user's virtualenv,
# so committing it hands everyone else a path that only works on one Mac.
.mcp.json
