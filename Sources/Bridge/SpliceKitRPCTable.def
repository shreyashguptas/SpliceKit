// SpliceKitRPCTable.def -- the built-in JSON-RPC methods, one row each.
//
// The single list of built-in RPC names. SpliceKitServer.m includes it to build the
// dispatch table (name -> handler), SpliceKitBridgeMetadata.m to build sBuiltinMetadata
// (what bridge.describe returns and what the busy/modal guard reads), and
// tools/gen_bridge_params.py reads it to find each method's handler.
//
//   SK_RPC(name, handler, safety, summary)
//     name     C string literal, the RPC method name
//     handler  NSDictionary *handler(NSDictionary *params), or NULL for a method that
//              SpliceKit_handleRequest dispatches explicitly (it wraps the handler's
//              result or computes it inline); the row then only carries its metadata
//     safety   @"safe" | @"state_dependent" | @"modal" | @"destructive" | @"system"
//              (see SpliceKitBridgeMetadata.m; when in doubt, state_dependent)
//     summary  NSString literal, one line for bridge.describe
//
// To add an RPC: write the handler function (declare it in SpliceKitServerInternal.h,
// or SpliceKitServerHandlers.h if other files call it too),
// add one row here, then run `python3 tools/gen_bridge_params.py` so bridge.describe
// lists the parameters it reads.
//
// Prefix routes (audioBusDiagnostics.*) and plugin methods registered with
// SpliceKit_registerPluginMethod (bridge.*, events.*, async.*) are not listed here.
//
// No include guard: this file is meant to be included several times, each time with
// its own definition of SK_RPC.

// system.* namespace
SK_RPC("system.version", SpliceKit_handleSystemVersion, @"safe", @"SpliceKit + FCP version info.")
SK_RPC("system.getClasses", SpliceKit_handleSystemGetClasses, @"safe", @"Enumerate ObjC classes in the process.")
SK_RPC("system.getMethods", SpliceKit_handleSystemGetMethods, @"safe", @"List methods on a class.")
SK_RPC("system.callMethod", SpliceKit_handleSystemCallMethod, @"system", @"Invoke an ObjC selector — can crash on bad selectors.")
SK_RPC("system.swizzle", SpliceKit_handleSystemSwizzle, @"system", @"Swap method implementations.")
SK_RPC("system.getProperties", SpliceKit_handleSystemGetProperties, @"safe", @"List properties on a class.")
SK_RPC("system.getProtocols", SpliceKit_handleSystemGetProtocols, @"safe", @"List protocol conformances.")
SK_RPC("system.getSuperchain", SpliceKit_handleSystemGetSuperchain, @"safe", @"Walk the inheritance chain.")
SK_RPC("system.getIvars", SpliceKit_handleSystemGetIvars, @"safe", @"List ivars with byte offsets.")
SK_RPC("system.callMethodWithArgs", SpliceKit_handleCallMethodWithArgs, @"system", @"Invoke an ObjC selector with typed args.")

// object.* namespace
SK_RPC("object.get", SpliceKit_handleObjectGet, @"system", @"Resolve an object handle.")
SK_RPC("object.release", SpliceKit_handleObjectRelease, @"system", @"Release an object handle.")
SK_RPC("object.list", SpliceKit_handleObjectList, @"safe", @"List active object handles.")
SK_RPC("object.getProperty", SpliceKit_handleGetProperty, @"safe", @"Read a property via KVC.")
SK_RPC("object.setProperty", SpliceKit_handleSetProperty, @"destructive", @"Write a property via KVC.")

// timeline.* namespace
// Dispatched explicitly in SpliceKit_handleRequest (result passed through SpliceKit_annotatePendingDialog).
SK_RPC("timeline.action", NULL, @"state_dependent", @"Run a timeline action via responder chain. Needs a loaded project.")
SK_RPC("timeline.directAction", SpliceKit_handleDirectTimelineAction, @"state_dependent", @"Call action* selector directly on timeline module.")
SK_RPC("timeline.getState", SpliceKit_handleTimelineGetState, @"safe", @"Read basic timeline state (name, duration).")
SK_RPC("timeline.getDetailedState", SpliceKit_handleTimelineGetDetailedState, @"safe", @"Snapshot spine clips, connected clips (anchoredItems), markers, handles, selection.")
SK_RPC("timeline.getMarkers", SpliceKit_handleTimelineGetMarkers, @"safe", @"List markers with time, kind, name, completion, handle.")
SK_RPC("timeline.setRange", SpliceKit_handleSetRange, @"state_dependent", @"Set in/out range selection.")
SK_RPC("timeline.addMarkers", SpliceKit_handleBatchAddMarkers, @"destructive", @"Batch-add markers at times.")
SK_RPC("timeline.bladeAtTimes", SpliceKit_handleBladeAtTimes, @"destructive", @"Batch-blade at multiple times.")
SK_RPC("timeline.trimClipsToBeats", SpliceKit_handleTrimClipsToBeats, @"destructive", @"Trim clips to a beat grid.")
SK_RPC("timeline.assembleRandomClipsToBeats", SpliceKit_handleAssembleRandomClipsToBeats, @"destructive", @"Build beat-synced cut from browser pool.")
SK_RPC("timeline.batchActions", SpliceKit_handleBatchActions, @"destructive", @"Run a sequence of timeline+playback actions.")
SK_RPC("timeline.batchExport", SpliceKit_handleBatchExport, @"destructive", @"Export each clip via Share.")
SK_RPC("timeline.selectItems", SpliceKit_handleTimelineSelectItems, @"state_dependent", @"Select timeline items by handle (replace/add/remove); never moves the playhead.")
SK_RPC("timeline.trimClip", SpliceKit_handleTimelineTrimClip, @"destructive", @"Ripple-trim one edit point of a clip by handle, by delta or to an absolute time.")
SK_RPC("timeline.getClipInfo", SpliceKit_handleTimelineGetClipInfo, @"safe", @"Clip information by handle: Info inspector fields (name, notes, roles, source media file and its media representation) plus SpliceKit extras (timeline placement, effects, title text, markers, transcript words, a frame from the source media file).")
SK_RPC("timeline.getAudioLevels", SpliceKit_handleTimelineGetAudioLevels, @"safe", @"Peak and RMS audio levels (dBFS) over time for one clip, a list of clips or every clip with audio on the timeline (at most 100 per call), mapped to timeline seconds, with the silence at each clip's start and end, the slices at full scale and, for neighbouring primary-storyline clips that were both analysed, the level jump at the cut between them (a transition on the cut is reported instead); decoded from the source media files by the audio-levels helper, so FCP's volume, fades, effects, retiming and the mix are not applied.")
SK_RPC("timeline.captureClipFrame", SpliceKit_handleTimelineCaptureClipFrame, @"state_dependent", @"Captures the clip as rendered in the Viewer; moves the playhead and restores it.")
SK_RPC("timeline.beginEdit", SpliceKit_handleTimelineBeginEdit, @"state_dependent", @"Open one undoable action on the sequence; edits until endEdit become one undo step.")
SK_RPC("timeline.endEdit", SpliceKit_handleTimelineEndEdit, @"state_dependent", @"Close the open undoable action (actionEnd:save:error:) so the group is one undo step.")

