// browser.* namespace
SK_RPC("browser.listClips", SpliceKit_handleBrowserListClips, @"safe", @"Clips in the browser (the active library's event clips): name, event, duration, handle.")
SK_RPC("browser.appendClip", SpliceKit_handleBrowserAppendClip, @"destructive", @"browser.placeClip with edit=append: paste a browser clip at the end of the primary storyline (the effect of Append E).")
SK_RPC("browser.insertClip", SpliceKit_handleBrowserInsertClip, @"destructive", @"browser.placeClip with edit=insert: paste a browser clip at the playhead (the effect of Insert W).")
SK_RPC("browser.connectClip", SpliceKit_handleBrowserConnectClip, @"destructive", @"browser.placeClip with edit=connect: paste a browser clip as a connected clip at the playhead (the effect of Connect Q).")
SK_RPC("browser.placeClip", SpliceKit_handleBrowserPlaceClipEdit, @"destructive", @"Place a browser clip, or a range of it (inSeconds/outSeconds from the clip's first frame), through FCP's pasteboard: edit=insert pastes at the playhead (the effect of Insert W), connect pastes as a connected clip (the effect of Connect Q, backtimed optional), append pastes at the end of the primary storyline (the effect of Append E); atSeconds moves the playhead first. The timeline is re-read before and after: placed, alsoNew, rangeHonored, positionVerified (within two frames). dryRun resolves without editing; the pasteboard is replaced.")
SK_RPC("media.importFile", SpliceKit_handleMediaImportFile, @"modal", @"Imports a media file into the active event (may show import UI).")
SK_RPC("media.removeClip", SpliceKit_handleMediaRemoveClip, @"destructive", @"Removes a source clip from an event's browser. The media file on disk is untouched.")

